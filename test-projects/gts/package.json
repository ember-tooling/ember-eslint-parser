{
  "name": "@test-project/gts",
  "private": true,
  "scripts": {
    "test:check": "pnpm run /test:check:.*/",
    "test:check:type-aware-error": "eslint src --max-warnings=0 | grep -q '5:49  error  '",
    "test:check:use-before-define": "eslint src/use-before-define.gts --max-warnings=0",
    "test:fix": "eslint ./src-fixable --fix --max-warnings=0",
    "types": "tsc --noEmit"
  },
  "devDependencies": {
    "@ember/test-waiters": "^3.1.0",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "@glint/template": "^1.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "ember-eslint-parser": "workspace:*",
    "ember-source": "^5.6.0",
    "eslint": "^8.0.1",
    "eslint-plugin-ember": "^12.0.0",
    "typescript": "^5.3.3"
  }
}
